rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validScore(value) {
      return value is int && value >= 1 && value <= 5;
    }
    function validStudent(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'name', 'course', 'year', 'nickname', 'birthDate', 'scores'])
        && d.keys().hasOnly(['id', 'name', 'course', 'year', 'nickname', 'birthDate', 'scores'])
        && d.id == id
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.name.matches('.*[^ ].*')
        && d.course in ['INFO', 'MEC', 'MAMB', 'PROD', 'TADS', 'TGA']
        && d.year is int && d.year >= 1998 && d.year <= 2026
        && d.nickname is string && d.nickname.size() <= 60
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$')
        && d.scores is map
        && d.scores.keys().hasAll(["resenha","presenca_vip","aura","modo_parceiro","carisma_natural","humor_de_milhoes","energia_de_grupo","criatividade_caotica","modo_atleta","talento_de_palco","drip_escolar","coracao_de_dorama","queridinho_dos_professores","cerebro_turbo","caos_controlado"])
        && d.scores.keys().hasOnly(["resenha","presenca_vip","aura","modo_parceiro","carisma_natural","humor_de_milhoes","energia_de_grupo","criatividade_caotica","modo_atleta","talento_de_palco","drip_escolar","coracao_de_dorama","queridinho_dos_professores","cerebro_turbo","caos_controlado"])
        && validScore(d.scores.resenha)
        && validScore(d.scores.presenca_vip)
        && validScore(d.scores.aura)
        && validScore(d.scores.modo_parceiro)
        && validScore(d.scores.carisma_natural)
        && validScore(d.scores.humor_de_milhoes)
        && validScore(d.scores.energia_de_grupo)
        && validScore(d.scores.criatividade_caotica)
        && validScore(d.scores.modo_atleta)
        && validScore(d.scores.talento_de_palco)
        && validScore(d.scores.drip_escolar)
        && validScore(d.scores.coracao_de_dorama)
        && validScore(d.scores.queridinho_dos_professores)
        && validScore(d.scores.cerebro_turbo)
        && validScore(d.scores.caos_controlado);
    }
    match /users/{uid}/students/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validStudent(id);
    }
    // Qualquer outro caminho permanece bloqueado.
  }
}
