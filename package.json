{
  "name": "piramid-game-firebase-tests",
  "private": true,
  "scripts": {
    "test:firebase": "firebase emulators:exec --project demo-piramid-game --only auth,firestore \"node --test --test-concurrency=1 tests/firebase/*.test.cjs\"",
    "emulators": "firebase emulators:start --project demo-piramid-game --only auth,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.34.0"
  }
}
